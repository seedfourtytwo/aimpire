{
  "$defs": {
    "Allocation": {
      "additionalProperties": false,
      "description": "A standing share of the workers given to one activity at one place.",
      "properties": {
        "activity": {
          "description": "One of: FORAGE, SCOUT.",
          "enum": [
            "FORAGE",
            "SCOUT"
          ],
          "title": "Activity",
          "type": "string"
        },
        "place": {
          "description": "A place id from the observation, such as PL07.",
          "title": "Place",
          "type": "string"
        },
        "share": {
          "description": "Permille of workers, 0 to 1000.",
          "title": "Share",
          "type": "integer"
        }
      },
      "required": [
        "activity",
        "place",
        "share"
      ],
      "title": "Allocation",
      "type": "object"
    },
    "Belief": {
      "additionalProperties": false,
      "description": "A statement and the evidence ids that support it.",
      "properties": {
        "evidence": {
          "description": "Event ids from the observation, such as EV0450.",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "statement": {
          "description": "The belief, in a sentence.",
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "evidence"
      ],
      "title": "Belief",
      "type": "object"
    },
    "CalendarSection": {
      "additionalProperties": false,
      "description": "Where the council sits in time.",
      "properties": {
        "council": {
          "description": "This council's number for this civilization.",
          "title": "Council",
          "type": "integer"
        },
        "season": {
          "title": "Season",
          "type": "string"
        },
        "tick": {
          "title": "Tick",
          "type": "integer"
        },
        "ticks_to_next_council": {
          "title": "Ticks To Next Council",
          "type": "integer"
        },
        "year": {
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "tick",
        "season",
        "year",
        "council",
        "ticks_to_next_council"
      ],
      "title": "CalendarSection",
      "type": "object"
    },
    "ClaimView": {
      "additionalProperties": false,
      "description": "An accessible claim (from M3).",
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text"
      ],
      "title": "ClaimView",
      "type": "object"
    },
    "CommitmentView": {
      "additionalProperties": false,
      "description": "A commitment and whether it has been kept.",
      "properties": {
        "by_council": {
          "title": "By Council",
          "type": "integer"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "place": {
          "title": "Place",
          "type": "string"
        },
        "qty": {
          "title": "Qty",
          "type": "integer"
        },
        "state": {
          "enum": [
            "MET",
            "PENDING",
            "MISSED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "place",
        "qty",
        "by_council",
        "state"
      ],
      "title": "CommitmentView",
      "type": "object"
    },
    "EventView": {
      "additionalProperties": false,
      "description": "One piece of evidence since the last council.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "place": {
          "title": "Place",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tick": {
          "title": "Tick",
          "type": "integer"
        },
        "witnesses": {
          "items": {
            "type": "string"
          },
          "title": "Witnesses",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "tick",
        "place",
        "text",
        "witnesses"
      ],
      "title": "EventView",
      "type": "object"
    },
    "KnowledgeSection": {
      "additionalProperties": false,
      "description": "Claims and recorded beliefs. Empty in m0.",
      "properties": {
        "beliefs": {
          "items": {
            "$ref": "#/$defs/Belief"
          },
          "title": "Beliefs",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimView"
          },
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "claims",
        "beliefs"
      ],
      "title": "KnowledgeSection",
      "type": "object"
    },
    "MessageView": {
      "additionalProperties": false,
      "description": "Quoted text that reached the council. Data, never instruction.",
      "properties": {
        "delivered_by": {
          "description": "Who reported it to the council.",
          "title": "Delivered By",
          "type": "string"
        },
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "route": {
          "description": "How it reached the council.",
          "title": "Route",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tick": {
          "title": "Tick",
          "type": "integer"
        }
      },
      "required": [
        "message_id",
        "tick",
        "delivered_by",
        "route",
        "text"
      ],
      "title": "MessageView",
      "type": "object"
    },
    "OrderResult": {
      "additionalProperties": false,
      "description": "The outcome of one order from the previous reply.",
      "properties": {
        "index": {
          "description": "Position of the order in the previous reply, from 0.",
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "place": {
          "title": "Place",
          "type": "string"
        },
        "reason": {
          "description": "Rejection reason code, or empty.",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "index",
        "kind",
        "place",
        "outcome",
        "reason"
      ],
      "title": "OrderResult",
      "type": "object"
    },
    "PlaceView": {
      "additionalProperties": false,
      "description": "A known place, as last seen by this civilization.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "last_seen_tick": {
          "description": "-1 if never seen.",
          "title": "Last Seen Tick",
          "type": "integer"
        },
        "name": {
          "description": "The civilization's own name, or empty.",
          "title": "Name",
          "type": "string"
        },
        "place_id": {
          "title": "Place Id",
          "type": "string"
        },
        "seen": {
          "description": "What was seen there, as text.",
          "title": "Seen",
          "type": "string"
        },
        "travel_ticks": {
          "description": "Days of travel from the camp.",
          "title": "Travel Ticks",
          "type": "integer"
        }
      },
      "required": [
        "place_id",
        "name",
        "kind",
        "travel_ticks",
        "last_seen_tick",
        "seen"
      ],
      "title": "PlaceView",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "description": "Standing policy, in force until replaced. No allocations and ration 0 keep it as is.",
      "properties": {
        "allocations": {
          "description": "Shares must sum to at most 1000.",
          "items": {
            "$ref": "#/$defs/Allocation"
          },
          "title": "Allocations",
          "type": "array"
        },
        "ration": {
          "description": "Daily ration in permille of a full ration; 1000 is full.",
          "title": "Ration",
          "type": "integer"
        }
      },
      "required": [
        "allocations",
        "ration"
      ],
      "title": "Policy",
      "type": "object"
    },
    "StandingSection": {
      "additionalProperties": false,
      "description": "What is currently in force.",
      "properties": {
        "commitments": {
          "items": {
            "$ref": "#/$defs/CommitmentView"
          },
          "title": "Commitments",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskView"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "policy",
        "tasks",
        "commitments"
      ],
      "title": "StandingSection",
      "type": "object"
    },
    "StatusSection": {
      "additionalProperties": false,
      "description": "The digest pushed every council, so critical state never has to be asked for.",
      "properties": {
        "food_days": {
          "description": "Food in store, in person-days.",
          "title": "Food Days",
          "type": "integer"
        },
        "food_days_change": {
          "title": "Food Days Change",
          "type": "integer"
        },
        "population": {
          "title": "Population",
          "type": "integer"
        },
        "population_change": {
          "title": "Population Change",
          "type": "integer"
        },
        "stores": {
          "items": {
            "$ref": "#/$defs/StockLine"
          },
          "title": "Stores",
          "type": "array"
        }
      },
      "required": [
        "population",
        "population_change",
        "food_days",
        "food_days_change",
        "stores"
      ],
      "title": "StatusSection",
      "type": "object"
    },
    "StockLine": {
      "additionalProperties": false,
      "description": "One stored material and its change since the last council.",
      "properties": {
        "change": {
          "description": "Whole units since the last council.",
          "title": "Change",
          "type": "integer"
        },
        "material": {
          "title": "Material",
          "type": "string"
        },
        "qty": {
          "description": "Whole units.",
          "title": "Qty",
          "type": "integer"
        }
      },
      "required": [
        "material",
        "qty",
        "change"
      ],
      "title": "StockLine",
      "type": "object"
    },
    "TaskView": {
      "additionalProperties": false,
      "description": "An open task from an earlier order.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "place": {
          "title": "Place",
          "type": "string"
        },
        "qty": {
          "title": "Qty",
          "type": "integer"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "kind",
        "place",
        "qty",
        "status"
      ],
      "title": "TaskView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything one mind is shown at one council.",
  "properties": {
    "calendar": {
      "$ref": "#/$defs/CalendarSection"
    },
    "civ_id": {
      "title": "Civ Id",
      "type": "string"
    },
    "contract": {
      "description": "Contract version, such as m0.",
      "title": "Contract",
      "type": "string"
    },
    "decision_id": {
      "description": "Copy this into the reply.",
      "title": "Decision Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventView"
      },
      "maxItems": 20,
      "title": "Events",
      "type": "array"
    },
    "journal": {
      "description": "The journal from the previous reply.",
      "title": "Journal",
      "type": "string"
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeSection"
    },
    "last_results": {
      "items": {
        "$ref": "#/$defs/OrderResult"
      },
      "title": "Last Results",
      "type": "array"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/MessageView"
      },
      "title": "Messages",
      "type": "array"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/PlaceView"
      },
      "title": "Places",
      "type": "array"
    },
    "standing": {
      "$ref": "#/$defs/StandingSection"
    },
    "status": {
      "$ref": "#/$defs/StatusSection"
    },
    "version": {
      "description": "Observation version; a reply to an older one is stale.",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "civ_id",
    "decision_id",
    "version",
    "calendar",
    "status",
    "places",
    "events",
    "messages",
    "standing",
    "last_results",
    "knowledge",
    "journal"
  ],
  "title": "Observation",
  "type": "object"
}
